# Supabase — get from your project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER expose to browser
# Used by the admin panel (lib/supabase/admin.ts) to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin panel ──────────────────────────────────────────────────────────────
# Comma-separated emails allowed to see /admin (all users' content, incl.
# legacy unowned demo rows). Leave blank to disable the admin panel entirely.
ADMIN_EMAILS=

# ── AI drafting assist ───────────────────────────────────────────────────────
# Set to "false" to disable "Draft with AI" (manual entry always works either way)
AI_DRAFT_ENABLED=true

# Get a key from https://openrouter.ai/keys. Without it (or if the call
# fails), drafting silently falls back to a built-in template generator —
# so it's optional, but real model output is far better quality.
OPENROUTER_API_KEY=

# Any model slug from https://openrouter.ai/models. Defaults to
# anthropic/claude-3.5-sonnet if unset.
AI_DRAFT_MODEL=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Webhook secret — from Stripe dashboard → Webhooks → your endpoint
# For local dev: stripe listen --forward-to localhost:3000/api/stripe/webhooks
STRIPE_WEBHOOK_SECRET=whsec_

# Your price IDs from Stripe dashboard → Products
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_

# ── Stripe Connect (set by Vibe Launchpad when provisioned via platform) ────
# Leave blank if running standalone with your own Stripe account
STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_PLATFORM_FEE_PERCENT=

# ── App URL (used for redirect URLs) ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
